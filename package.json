{
  "name": "smmbot",
  "version": "2.0.0",
  "description": "SMMBot 2.0 — Organic Growth Suite",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"vite --port 5173\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build",
    "build:frontend": "tsc && vite build",
    "build:electron": "electron-packager . SMMBot --platform=win32 --arch=x64 --out=dist-electron --overwrite --ignore=\"^/src\" --ignore=\"^/dist-electron\" --ignore=\"^/smmbot-tauri\" --ignore=\"\\.spec$\" --ignore=\"^/vite\\.config\" --ignore=\"^/tsconfig\"",
    "build:all": "npm run build && npm run build:electron"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "socks-proxy-agent": "^8.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "recharts": "^2.10.3",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.smmbot.growth",
    "productName": "SMMBot",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.js",
      "scraper.py",
      "dist/**/*"
    ]
  }
}
